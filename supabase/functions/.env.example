# Copy to supabase/functions/.env for local Edge Function testing.
# Deploy with: supabase secrets set --env-file supabase/functions/.env

RESEND_API_KEY=
# Prefer separate name + address (avoids quote parsing issues in .env):
RESEND_FROM_NAME=Doom Watch Party
RESEND_FROM_ADDRESS=noreply@doomwatchparty.online
# Or a single combined value instead of the two lines above:
# RESEND_FROM_EMAIL=Doom Watch Party <noreply@doomwatchparty.online>
SEND_EMAIL_HOOK_SECRET=
RESEND_TEMPLATE_CONFIRM_SIGNUP=
RESEND_TEMPLATE_PASSWORD_RESET=
RESEND_TEMPLATE_AUTH_ACTION=
