# Public app origin used for auth redirects and invite links.
# Local: http://127.0.0.1:5173
# Vercel Production: https://doomwatchparty.vercel.app (required)
# Vercel Preview: leave unset so the Vite build derives https://$VERCEL_URL
VITE_APP_URL=

# Supabase browser client. Use the publishable (anon) key only.
# Local values come from `npx supabase status` (never commit real keys).
# Local auth emails are captured in Mailpit at http://127.0.0.1:54324.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional — required to subscribe devices for push notifications (public VAPID key only).
VITE_VAPID_PUBLIC_KEY=

# Server/script only — never prefix with VITE_ and never put this in Vercel.
TMDB_API_READ_TOKEN=

# Hosted Supabase Auth email (Resend API via Edge Function). Set these as Supabase
# Edge Function secrets (`supabase secrets set --env-file supabase/functions/.env`),
# not in Vercel or the Vite client. Local `npx supabase start` still uses Mailpit
# unless the send_email hook is enabled in config.toml.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Doomsday Watch Group <noreply@doomwatchparty.online>
SEND_EMAIL_HOOK_SECRET=
RESEND_TEMPLATE_CONFIRM_SIGNUP=
RESEND_TEMPLATE_PASSWORD_RESET=
RESEND_TEMPLATE_AUTH_ACTION=

# Playwright E2E only — from `npx supabase status` (SERVICE_ROLE_KEY). Never commit.
E2E_SUPABASE_SERVICE_ROLE_KEY=

# Optional Playwright overrides when `.env` points at production Supabase.
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=
